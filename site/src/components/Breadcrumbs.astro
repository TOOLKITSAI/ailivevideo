---
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((item, index) => (
      <li>
        {item.href && index < items.length - 1 ? <a href={item.href}>{item.label}</a> : <span aria-current={index === items.length - 1 ? 'page' : undefined}>{item.label}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs { padding-block: 1.5rem 0; color: var(--color-muted); font-size: 0.875rem; }
  ol { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  li:not(:last-child)::after { margin-left: 0.5rem; color: var(--color-border); content: '/'; }
</style>