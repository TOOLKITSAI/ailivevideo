---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import SeoHead from '../components/SeoHead.astro';
import { breadcrumbJsonLd, canonicalUrl, type BreadcrumbItem } from '../lib/seo';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
  structuredData?: unknown[];
  breadcrumbs?: BreadcrumbItem[];
}

const { title, description, canonicalPath, noindex = false, structuredData = [], breadcrumbs = [] } = Astro.props;
const pageCanonicalUrl = canonicalUrl(canonicalPath);
const jsonLd = [...structuredData, ...(breadcrumbs.length > 0 ? [breadcrumbJsonLd(breadcrumbs)] : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead title={title} description={description} canonicalUrl={pageCanonicalUrl} noindex={noindex} />
    {jsonLd.map((value) => <JsonLd value={value} />)}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
