---
import type { CollectionEntry } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolCard, { type DirectoryTool } from '../../components/ToolCard.astro';
import { CATEGORIES, type CategorySlug } from '../../data/categories';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedComparisons, getPublishedGuides, getToolsByCategory } from '../../lib/content';
import { canonicalUrl, itemListJsonLd } from '../../lib/seo';

interface Props {
  category: CategorySlug;
}

export async function getStaticPaths() {
  return Object.entries(CATEGORIES).map(([slug, category]) => ({
    params: { slug },
    props: { category: slug as CategorySlug, categoryName: category.name },
  }));
}

const { category } = Astro.props;
const categoryInfo = CATEGORIES[category];
const tools = await getToolsByCategory(category);
const toolSlugs = new Set(tools.map((tool) => tool.id));
const [comparisons, guides] = await Promise.all([getPublishedComparisons(), getPublishedGuides()]);
const relatedComparisons = comparisons.filter((comparison) =>
  toolSlugs.has(comparison.data.toolA) || toolSlugs.has(comparison.data.toolB),
);
const relatedGuides = guides.filter((guide) => guide.data.relatedTools.some((slug) => toolSlugs.has(slug)));
const canonicalPath = `/categories/${category}/`;

function toDirectoryTool(entry: CollectionEntry<'tools'>): DirectoryTool {
  return {
    slug: entry.id,
    name: entry.data.name,
    categorySlugs: entry.data.categories,
    categoryLabel: CATEGORIES[entry.data.categories[0]].name,
    oneLineVerdict: entry.data.oneLineVerdict,
    bestFor: entry.data.bestFor,
    freeAccessStatus: entry.data.freeAccessStatus,
    apiAvailable: entry.data.apiAvailable,
    realTimeCapability: entry.data.realTimeCapability,
  };
}
---

<BaseLayout
  title={categoryInfo.name + ' — AI Live Video Tools'}
  description={categoryInfo.description}
  canonicalPath={canonicalPath}
  pagefindContentType="category"
  pagefindCategories={[category]}
  structuredData={[itemListJsonLd(categoryInfo.name, tools.map((tool) => ({ name: tool.data.name, url: canonicalUrl('/tools/' + tool.id + '/') })))]}
  breadcrumbs={[{ name: 'Home', url: canonicalUrl('/') }, { name: 'Tools', url: canonicalUrl('/tools/') }, { name: categoryInfo.name }]}
>
  <div class="container category-page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: categoryInfo.name }]} />

    <header class="category-page__hero">
      <p class="eyebrow">AI live video category</p>
      <h1>{categoryInfo.name}</h1>
      <p>{categoryInfo.description}</p>
      <p class="category-page__count">{tools.length} {tools.length === 1 ? 'tool' : 'tools'} in this category</p>
    </header>

    <section aria-labelledby="about-category-heading">
      <h2 id="about-category-heading">What belongs in this category</h2>
      <p>These listings cover products whose primary live-video workflow matches {categoryInfo.name.toLocaleLowerCase('en')}.</p>
    </section>

    <section aria-labelledby="tools-heading">
      <h2 id="tools-heading">Tools</h2>
      {tools.length > 0 ? (
        <div class="tool-grid">{tools.map((tool) => <ToolCard tool={toDirectoryTool(tool)} />)}</div>
      ) : (
        <p class="category-page__empty">Curated listings for this category are being prepared. Please check back as new editorial batches are published.</p>
      )}
    </section>

    {relatedComparisons.length > 0 && (
      <section aria-labelledby="comparisons-heading">
        <h2 id="comparisons-heading">Related comparisons</h2>
        <ul>{relatedComparisons.map((comparison) => <li><a href={`/comparisons/${comparison.id}/`}>{comparison.data.title}</a></li>)}</ul>
      </section>
    )}

    {relatedGuides.length > 0 && (
      <section aria-labelledby="guides-heading">
        <h2 id="guides-heading">Related guides</h2>
        <ul>{relatedGuides.map((guide) => <li><a href={`/guides/${guide.id}/`}>{guide.data.title}</a></li>)}</ul>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .category-page { padding-bottom: 4rem; }
  .category-page__hero { max-width: 48rem; padding-block: 2rem 3rem; }
  .category-page__hero > p:first-of-type { color: var(--color-muted); font-size: 1.125rem; }
  .category-page__count { color: var(--color-accent-strong); font-weight: 750; }
  .category-page section { margin-top: 2rem; }
  .category-page h2 { font-size: 1.4rem; }
  .category-page ul { padding-left: 1.25rem; }
  .category-page li + li { margin-top: 0.5rem; }
  .category-page__empty { max-width: 48rem; padding: 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
</style>