---
import BaseLayout from '../layouts/BaseLayout.astro';
import { canonicalUrl } from '../lib/seo';
---

<BaseLayout
  title="Privacy | AI Live Video"
  description="The current, limited privacy position for the AI Live Video static site."
  canonicalPath="/privacy/"
  breadcrumbs={[{ name: 'Home', url: canonicalUrl('/') }, { name: 'Privacy' }]}
>
  <article class="container trust-page">
    <header class="trust-page__hero">
      <p class="eyebrow">Privacy</p>
      <h1>A limited static-site policy</h1>
      <p>This page describes the current static MVP and will need review if site features or services change.</p>
    </header>

    <section>
      <h2>Current site features</h2>
      <p>The current site does not provide accounts, user-submission forms, a site database, or an analytics integration. We do not ask visitors to create an account or submit personal information through this site.</p>
    </section>
    <section>
      <h2>Planned analytics</h2>
      <p>Cloudflare Web Analytics is the only analytics service currently planned. It is not active unless and until it is configured. If it is activated, this page will be updated to describe the service and the information relevant to that implementation.</p>
    </section>
    <section>
      <h2>External sites</h2>
      <p>Links to other sites are governed by those sites' own practices. Review the privacy information provided by an external site before sharing information there.</p>
    </section>
  </article>
</BaseLayout>

<style>
  .trust-page { padding-bottom: 4rem; } .trust-page__hero { max-width: 48rem; padding-block: 2rem 3rem; } .trust-page__hero > p:last-child { color: var(--color-muted); font-size: 1.125rem; } .trust-page section { max-width: 48rem; margin-top: 1.25rem; padding: 1.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); box-shadow: var(--shadow-soft); } .trust-page h2 { font-size: 1.4rem; }
</style>
