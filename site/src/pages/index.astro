---
import SiteSearch from '../components/SiteSearch.astro';
import { type DirectoryTool } from '../components/ToolCard.astro';
import { CATEGORIES, CATEGORY_SLUGS } from '../data/categories';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFeaturedTools, getPublishedComparisons, getPublishedGuides, getPublishedTools } from '../lib/content';
import { websiteJsonLd } from '../lib/seo';

const [publishedTools, markedFeaturedTools, comparisons, guides] = await Promise.all([
  getPublishedTools(),
  getFeaturedTools(),
  getPublishedComparisons(),
  getPublishedGuides(),
]);

const featuredTools = (markedFeaturedTools.length > 0 ? markedFeaturedTools : publishedTools).slice(0, 4);
const featuredCards: DirectoryTool[] = featuredTools.map((tool) => ({
  slug: tool.id,
  name: tool.data.name,
  categorySlugs: tool.data.categories,
  categoryLabel: CATEGORIES[tool.data.categories[0]].name,
  oneLineVerdict: tool.data.oneLineVerdict,
  bestFor: tool.data.bestFor,
  freeAccessStatus: tool.data.freeAccessStatus,
  apiAvailable: tool.data.apiAvailable,
  realTimeCapability: tool.data.realTimeCapability,
}));
const latestComparisons = comparisons.sort((first, second) => second.data.updatedAt.getTime() - first.data.updatedAt.getTime());
const latestGuides = guides.sort((first, second) => second.data.updatedAt.getTime() - first.data.updatedAt.getTime()).slice(0, 3);
---

<BaseLayout title="AI Live Video — Tools, Comparisons & Guides" description="Explore AI live video tools for avatars, real-time generation, translation, streaming and live shopping, with practical guides and product comparisons." canonicalPath="/" pagefindContentType="homepage" structuredData={[websiteJsonLd()]}>
<section class="discovery-top"><div class="container"><div><p class="discovery-count">{publishedTools.length} tools · {CATEGORY_SLUGS.length} categories</p><h1>Find the right AI live video tool</h1><p>Explore tools for avatars, live shopping, translation and real-time video generation.</p></div><div><SiteSearch /><a class="homepage-hero__browse" href="/tools/">Browse all tools</a></div></div></section>
<div class="container discovery-layout"><aside id="browse-categories" class="discovery-categories" aria-label="Browse by category"><h2>Browse by need</h2><ul>{CATEGORY_SLUGS.map(slug=><li><a href={`/categories/${slug}/`}>{{"ai-avatars":"AI avatars","real-time-generative-video":"Real-time generation","ai-video-agents":"Video agents","live-translation-dubbing":"Live translation","streaming-production-automation":"Streaming automation","ai-live-shopping":"Live shopping"}[slug]}</a></li>)}</ul></aside>
<section aria-labelledby="featured-tools-title"><div class="discovery-heading"><h2 id="featured-tools-title">Featured tools</h2><a href="/tools/">View all tools →</a></div><div class="discovery-grid">{featuredCards.map(tool=><article class="discovery-tool"><figure><a href={`/tools/${tool.slug}/`} tabindex="-1" aria-hidden="true"><img src={`/images/tools/${tool.slug}-600.webp`} width="600" height="375" alt="" loading="lazy" /></a></figure><p class="tool-kind">{tool.categoryLabel}</p><h3><a href={`/tools/${tool.slug}/`}>{tool.name}</a></h3><p>{tool.oneLineVerdict}</p><a href={`/tools/${tool.slug}/`} aria-label={`View details for ${tool.name}`}>View details</a></article>)}</div></section></div>
<section class="reading-band"><div class="container reading-layout"><div><div class="discovery-heading"><h2>Compare your options</h2></div><ul class="reading-list">{latestComparisons.map(article=><li><h3><a href={`/compare/${article.id}/`}>{article.data.title}</a></h3><p>{article.data.description}</p></li>)}</ul></div><div><div class="discovery-heading"><h2>Learn about AI live video</h2></div><ul class="reading-list">{latestGuides.map(article=><li><h3><a href={`/guides/${article.id}/`}>{article.data.title}</a></h3><p>{article.data.description}</p></li>)}</ul><a class="homepage-hero__browse" href="/guides/what-is-ai-live-video/">Read the introduction</a></div></div></section>
<div class="container method-note"><p>Product claims, real-time capabilities and official sources, checked before publication. <a href="/editorial-policy/">Our editorial policy</a></p></div>
</BaseLayout>
