---
import ToolCard, { type DirectoryTool } from '../components/ToolCard.astro';
import { CATEGORIES, CATEGORY_SLUGS } from '../data/categories';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFeaturedTools, getPublishedComparisons, getPublishedGuides, getPublishedTools } from '../lib/content';

const [publishedTools, markedFeaturedTools, comparisons, guides] = await Promise.all([
  getPublishedTools(),
  getFeaturedTools(),
  getPublishedComparisons(),
  getPublishedGuides(),
]);

const featuredTools = (markedFeaturedTools.length > 0 ? markedFeaturedTools : publishedTools).slice(0, 4);
const featuredCards: DirectoryTool[] = featuredTools.map((tool) => ({
  slug: tool.id,
  name: tool.data.name,
  categorySlugs: tool.data.categories,
  categoryLabel: CATEGORIES[tool.data.categories[0]].name,
  oneLineVerdict: tool.data.oneLineVerdict,
  bestFor: tool.data.bestFor,
  freeAccessStatus: tool.data.freeAccessStatus,
  apiAvailable: tool.data.apiAvailable,
  realTimeCapability: tool.data.realTimeCapability,
}));
const latestComparisons = comparisons.sort((first, second) => second.data.updatedAt.getTime() - first.data.updatedAt.getTime());
const latestGuides = guides.sort((first, second) => second.data.updatedAt.getTime() - first.data.updatedAt.getTime()).slice(0, 3);
---

<BaseLayout
  title="AI Live Video"
  description="Curated AI live video tools and practical guides."
  canonicalPath="/"
>
  <section class="homepage-hero" aria-labelledby="homepage-title">
    <div class="container homepage-hero__inner">
      <p class="eyebrow">Curated and independently reviewed</p>
      <h1 id="homepage-title">Find the right AI live video tool</h1>
      <p class="homepage-hero__description">Explore curated tools for avatars, live shopping, translation and real-time video generation.</p>
      <form class="homepage-search" action="/tools/" method="get" data-pagefind-search>
        <label for="homepage-search">Search AI live video tools</label>
        <div class="homepage-search__controls">
          <input id="homepage-search" name="q" type="search" placeholder="Search tools, comparisons, and guides" autocomplete="off" />
          <button class="button" type="submit">Search</button>
        </div>
      </form>
      <a class="homepage-hero__browse" href="/tools/">Browse all tools</a>
    </div>
  </section>

  <section class="homepage-section" aria-labelledby="popular-categories-title">
    <div class="container">
      <div class="homepage-section__heading">
        <div><p class="eyebrow">Browse by need</p><h2 id="popular-categories-title">Popular categories</h2></div>
        <a href="/categories/ai-avatars/">Explore categories</a>
      </div>
      <ul class="category-grid" role="list">
        {CATEGORY_SLUGS.map((slug) => (
          <li><a class="category-card" href={`/categories/${slug}/`}><span>{CATEGORIES[slug].name}</span><small>{CATEGORIES[slug].description}</small></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="homepage-section homepage-section--surface" aria-labelledby="featured-tools-title">
    <div class="container">
      <div class="homepage-section__heading">
        <div><p class="eyebrow">Editorial picks</p><h2 id="featured-tools-title">Featured tools</h2></div>
        <a href="/tools/">View all tools</a>
      </div>
      {featuredCards.length > 0 ? (
        <div class="tool-grid">{featuredCards.map((tool) => <ToolCard tool={tool} />)}</div>
      ) : (
        <div class="homepage-empty-state">
          <h3>Tools are being reviewed</h3>
          <p>Our directory is growing. Browse the tool directory to see newly published records.</p>
          <a class="button" href="/tools/">Browse the tool directory</a>
        </div>
      )}
    </div>
  </section>

  <section class="homepage-section" aria-labelledby="featured-comparison-title">
    <div class="container">
      <div class="homepage-section__heading"><div><p class="eyebrow">Make a clearer choice</p><h2 id="featured-comparison-title">Featured comparison</h2></div><a href="/compare/">View comparisons</a></div>
      {latestComparisons[0] ? (
        <article class="featured-article"><p class="eyebrow">Comparison</p><h3><a href={`/compare/${latestComparisons[0].id}/`}>{latestComparisons[0].data.title}</a></h3><p>{latestComparisons[0].data.description}</p><a href={`/compare/${latestComparisons[0].id}/`}>Read comparison</a></article>
      ) : (
        <div class="homepage-empty-state"><p>Published comparisons will appear here as they are independently reviewed.</p><a href="/tools/">Browse the tool directory</a></div>
      )}
    </div>
  </section>

  <section class="homepage-section homepage-section--surface" aria-labelledby="guides-title">
    <div class="container">
      <div class="homepage-section__heading"><div><p class="eyebrow">Practical reading</p><h2 id="guides-title">Learn about AI live video</h2></div><a href="/guides/">View guides</a></div>
      {latestGuides.length > 0 ? (
        <div class="article-grid">{latestGuides.map((guide) => <article class="article-card"><p class="eyebrow">Guide</p><h3><a href={`/guides/${guide.id}/`}>{guide.data.title}</a></h3><p>{guide.data.description}</p><a href={`/guides/${guide.id}/`}>Read guide</a></article>)}</div>
      ) : (
        <div class="homepage-empty-state"><p>Guides will appear here as our editors publish practical research.</p></div>
      )}
    </div>
  </section>

  <section class="homepage-section homepage-method" aria-labelledby="method-title">
    <div class="container"><p class="eyebrow">Our editorial method</p><h2 id="method-title">Useful recommendations, with the evidence in view</h2><p>We review product claims, pricing, real-time capabilities, and official sources before publishing a record. <a href="/editorial-policy/">Read our editorial policy</a>.</p></div>
  </section>
</BaseLayout>
